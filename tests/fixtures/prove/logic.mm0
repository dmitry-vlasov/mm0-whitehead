-- The specification of logic.mm1, written by hand: its sorts, terms, notations and
-- statements, without the proofs. logic.mmb, compiled from logic.mm1, proves it
-- (`mm0-whitehead verify logic.mm0 logic.mmb`). The tests of the prover's patterns read
-- the notations from here.
delimiter $ ( ~ $ $ ) $;
provable sort wff;
term wi (ph ps: wff): wff; infixr wi: $->$ prec 25;
term wn (ph: wff): wff; prefix wn: $~$ prec 41;

axiom ax_1 (ph ps: wff): $ ph -> ps -> ph $;
axiom ax_2 (ph ps ch: wff): $ (ph -> ps -> ch) -> (ph -> ps) -> ph -> ch $;
axiom ax_3 (ph ps: wff): $ (~ph -> ~ps) -> ps -> ph $;
axiom ax_mp (ph ps: wff): $ ph $ > $ ph -> ps $ > $ ps $;

theorem a1i (ph ps: wff): $ ph $ > $ ps -> ph $;
theorem a2i (ph ps ch: wff): $ ph -> ps -> ch $ > $ (ph -> ps) -> ph -> ch $;
theorem mpd (ph ps ch: wff): $ ph -> ps $ > $ ph -> ps -> ch $ > $ ph -> ch $;
theorem id (ph: wff): $ ph -> ph $;
theorem syl (ph ps ch: wff): $ ps -> ch $ > $ ph -> ps $ > $ ph -> ch $;
theorem a2d (ph ps ch th: wff): $ ph -> ps -> ch -> th $ > $ ph -> (ps -> ch) -> ps -> th $;
theorem com12 (ph ps ch: wff): $ ph -> ps -> ch $ > $ ps -> ph -> ch $;
theorem mpcom (ph ps: wff): $ ph -> (ph -> ps) -> ps $;
theorem imidm (ph ps: wff): $ (ph -> ph -> ps) -> ph -> ps $;
theorem imim2 (ph ps ch: wff): $ (ps -> ch) -> (ph -> ps) -> ph -> ch $;
theorem con1 (ph ps: wff): $ (~ph -> ps) -> (~ps -> ph) $;
theorem con2 (ph ps: wff): $ (ph -> ~ps) -> (ps -> ~ph) $;

sort set;
term wal {x: set} (ph: wff x): wff; prefix wal: $A.$ prec 41;

axiom ax_gen {x: set} (ph: wff x): $ ph $ > $ A. x ph $;
axiom ax_4 {x: set} (ph ps: wff x): $ A. x (ph -> ps) -> A. x ph -> A. x ps $;
axiom ax_5 {x: set} (ph: wff): $ ph -> A. x ph $;
axiom sp {x: set} (ph: wff x): $ A. x ph -> ph $;

theorem alimi {x: set} (ph ps: wff x): $ ph -> ps $ > $ A. x ph -> A. x ps $;
theorem alrimi {x: set} (ph: wff) (ps: wff x): $ ph -> ps $ > $ ph -> A. x ps $;
theorem alcomi {x y: set} (ph: wff x y): $ ph $ > $ A. x A. y ph $;
theorem dummy (ph: wff): $ ph -> ph $;
